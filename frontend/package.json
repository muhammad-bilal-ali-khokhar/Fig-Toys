{
  "name": "fig-mobile-pos-frontend",
  "version": "0.1.91",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack -p 58340",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:production": "node scripts/prepare-production.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "html2canvas-pro": "^2.3.6",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "next": "^15.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
