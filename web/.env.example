# Owner console (web) environment

# Public URL of the POS backend API used by the live dashboard and admin tools.
# In local development it defaults to http://localhost:47620/api.
POS_ADMIN_API_URL="http://localhost:47620/api"

# Must match LICENSE_LOCAL_ADMIN_TOKEN in the backend .env.
# Used server-side by the /api/live/* proxy routes. Never expose to the browser.
LICENSE_LOCAL_ADMIN_TOKEN=""

# Public VAPID key for Web Push subscriptions. The private key stays on the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
